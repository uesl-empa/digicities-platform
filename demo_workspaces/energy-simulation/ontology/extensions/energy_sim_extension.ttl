@prefix dici_onto: <https://digicities.info/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

dici_onto:AirHeated rdfs:label "Air / heat pump" ;
    rdfs:subClassOf dici_onto:DHWSupply,
        dici_onto:HeatingSupply .

dici_onto:Building a owl:Class ;
    rdfs:label "Building" ;
    rdfs:subClassOf dici_onto:Component .

dici_onto:BuildingAge a owl:Class ;
    rdfs:label "Building Age (construction year)" ;
    rdfs:subClassOf dici_onto:BuildingAttribute,
        dici_onto:PhysicalAttribute ;
    dici_onto:hasDefaultUnit <http://qudt.org/vocab/unit/YR> .

dici_onto:DistrictHeated rdfs:label "District heated" ;
    rdfs:subClassOf dici_onto:DHWSupply,
        dici_onto:HeatingSupply .

dici_onto:ElectricallyHeated rdfs:label "Electrically heated" ;
    rdfs:subClassOf dici_onto:DHWSupply,
        dici_onto:HeatingSupply .

dici_onto:GasHeated rdfs:label "Gas heated" ;
    rdfs:subClassOf dici_onto:DHWSupply,
        dici_onto:HeatingSupply .

dici_onto:GroundFloorArea a owl:Class ;
    rdfs:label "Ground Floor Area" ;
    rdfs:subClassOf dici_onto:BuildingAttribute,
        dici_onto:PhysicalAttribute ;
    dici_onto:hasDefaultUnit <http://qudt.org/vocab/unit/M2> .

dici_onto:MFH rdfs:label "Multi-family house" ;
    rdfs:subClassOf dici_onto:SIA2024BuildingType .

dici_onto:NumberOfFloors a owl:Class ;
    rdfs:label "Number of Floors" ;
    rdfs:subClassOf dici_onto:BuildingAttribute,
        dici_onto:PhysicalAttribute ;
    dici_onto:hasDefaultUnit <http://qudt.org/vocab/unit/NUM> .

dici_onto:Office rdfs:label "Office" ;
    rdfs:subClassOf dici_onto:SIA2024BuildingType .

dici_onto:OilHeated rdfs:label "Oil heated" ;
    rdfs:subClassOf dici_onto:DHWSupply,
        dici_onto:HeatingSupply .

dici_onto:Retail rdfs:label "Retail" ;
    rdfs:subClassOf dici_onto:SIA2024BuildingType .

dici_onto:SFH rdfs:label "Single-family house" ;
    rdfs:subClassOf dici_onto:SIA2024BuildingType .

dici_onto:WeatherEPW a owl:Class ;
    rdfs:label "Weather EPW file" ;
    rdfs:subClassOf dici_onto:PhysicalAttribute .

dici_onto:SIA2024BuildingType a owl:Class ;
    rdfs:label "SIA 2024 Building Type" ;
    rdfs:subClassOf dici_onto:BuildingAttribute,
        dici_onto:CategoricalAttribute .

dici_onto:DHWSupply a owl:Class ;
    rdfs:label "Domestic Hot Water Supply" ;
    rdfs:subClassOf dici_onto:BuildingAttribute,
        dici_onto:CategoricalAttribute .

dici_onto:HeatingSupply a owl:Class ;
    rdfs:label "Space Heating Supply" ;
    rdfs:subClassOf dici_onto:BuildingAttribute,
        dici_onto:CategoricalAttribute .

dici_onto:BuildingAttribute a owl:Class ;
    rdfs:label "Building Attribute" ;
    rdfs:subClassOf dici_onto:Attribute .

