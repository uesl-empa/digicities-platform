@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:   <http://purl.org/dc/terms/> .
@prefix qudt:      <http://qudt.org/schema/qudt/> .
@prefix unit:      <http://qudt.org/vocab/unit/> .
@prefix dici_onto: <https://digicities.info/ontology#> .
@prefix me:        <https://digicities.info/proj/motel-energy/> .
@prefix sc:        <https://digicities.info/proj/motel-energy/scenarios/> .

# =============================================================================
# Scenario: chain-wide solar rollout
#
# Variant of the baseline where every motel installs rooftop PV
# sized to 50 kW per 1000 m² of gross floor area. The assumption is
# applied via "modifier" attributes — same domain class, new URI,
# supersedes the baseline attribute via dici_onto:supersedesAttribute.
# =============================================================================

sc:solar_rollout
    a dici_onto:Scenario ;
    rdfs:label "Motel chain — solar rollout"^^xsd:string ;
    rdfs:comment "Chain-wide PV rollout sized at 50 kW per 1000 m² floor area. Baseline electricity consumption stays the same; the assumption increases InstalledPVCapacity on every motel."^^xsd:string ;
    dcterms:created "2026-05-24"^^xsd:date ;
    dici_onto:basedOn sc:baseline ;
    dici_onto:hasAssumption sc:assumption_solar ;
    dici_onto:modifiedComponents "3"^^xsd:integer .

sc:assumption_solar
    a dici_onto:Assumption, dici_onto:AssumptionSeries ;
    rdfs:label "Install rooftop PV on every motel (50 kW per 1000 m² floor area)"^^xsd:string ;
    rdfs:comment "Series assumption applied to all three motels. Sizing rule yields 60 / 90 / 125 kW for Motel A / B / C respectively."^^xsd:string .

# --- Modified attributes (new URIs, supersede the baseline ones) ---

<https://digicities.info/proj/motel-energy/MotelA/installedPVCapacity_solar>
    a dici_onto:InstalledPVCapacity ;
    rdfs:label "installedPVCapacity (after rollout)"^^xsd:string ;
    qudt:value "60.0"^^xsd:decimal ;
    qudt:unit unit:KiloW ;
    dici_onto:supersedesAttribute <https://digicities.info/proj/motel-energy/MotelA/installedPVCapacity> ;
    dici_onto:usedInScenario sc:solar_rollout .

<https://digicities.info/proj/motel-energy/MotelB/installedPVCapacity_solar>
    a dici_onto:InstalledPVCapacity ;
    rdfs:label "installedPVCapacity (after rollout)"^^xsd:string ;
    qudt:value "90.0"^^xsd:decimal ;
    qudt:unit unit:KiloW ;
    dici_onto:supersedesAttribute <https://digicities.info/proj/motel-energy/MotelB/installedPVCapacity> ;
    dici_onto:usedInScenario sc:solar_rollout .

<https://digicities.info/proj/motel-energy/MotelC/installedPVCapacity_solar>
    a dici_onto:InstalledPVCapacity ;
    rdfs:label "installedPVCapacity (after rollout)"^^xsd:string ;
    qudt:value "125.0"^^xsd:decimal ;
    qudt:unit unit:KiloW ;
    dici_onto:supersedesAttribute <https://digicities.info/proj/motel-energy/MotelC/installedPVCapacity> ;
    dici_onto:usedInScenario sc:solar_rollout .

# Same components are part of this scenario (their non-modified attributes
# carry through unchanged).
me:RoadsideMotelChain dici_onto:usedInScenario sc:solar_rollout .
me:MotelA dici_onto:usedInScenario sc:solar_rollout .
me:MotelB dici_onto:usedInScenario sc:solar_rollout .
me:MotelC dici_onto:usedInScenario sc:solar_rollout .
