@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:   <http://purl.org/dc/terms/> .
@prefix dici_onto: <https://digicities.info/ontology#> .
@prefix me:        <https://digicities.info/proj/motel-energy/> .
@prefix sc:        <https://digicities.info/proj/motel-energy/scenarios/> .

# =============================================================================
# Scenario: Roadside Motel Chain — baseline
#
# Snapshot anchor — every motel and its attributes belong to this scenario.
# No modifications. Matches the alpine_village_baseline pattern.
# =============================================================================

sc:baseline
    a dici_onto:Scenario ;
    rdfs:label "Motel chain — baseline"^^xsd:string ;
    rdfs:comment "Current state of the three motels: no PV at A and C, modest PV at B, no EV chargers."^^xsd:string ;
    dcterms:created "2026-05-24"^^xsd:date ;
    dici_onto:modifiedComponents "0"^^xsd:integer .

me:RoadsideMotelChain dici_onto:usedInScenario sc:baseline .
me:MotelA dici_onto:usedInScenario sc:baseline .
me:MotelB dici_onto:usedInScenario sc:baseline .
me:MotelC dici_onto:usedInScenario sc:baseline .
