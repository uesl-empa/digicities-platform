@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt:      <http://qudt.org/schema/qudt/> .
@prefix unit:      <http://qudt.org/vocab/unit/> .
@prefix dici_onto: <https://digicities.info/ontology#> .
@prefix me:        <https://digicities.info/proj/motel-energy/> .

# =============================================================================
# Motel chain instance data
#
# Three small motels along a regional highway, each modelled as a Building.
# Attributes used: GrossFloorArea + AnnualElectricityConsumption +
# AnnualHeatConsumption + EVCount + InstalledPVCapacity.
#
# All attribute classes come from the bundled motel_project extension
# (extensions/motel_project.ttl). Instance URIs follow the path-style
# convention <site/Component/attribute>.
# =============================================================================

me:RoadsideMotelChain
    a dici_onto:Actor ;
    rdfs:label "Roadside Motel Chain"^^xsd:string ;
    rdfs:comment "A three-site motel chain along the Alpine highway. Demo data for the Digicities usecase template."^^xsd:string .

# -----------------------------------------------------------------------------
# Motel A — small motel, no PV, no EV chargers (baseline pre-investment state)
# -----------------------------------------------------------------------------
me:MotelA
    a dici_onto:Building ;
    rdfs:label "Motel A — Highway Junction"^^xsd:string ;
    dici_onto:partOf me:RoadsideMotelChain ;
    dici_onto:hasBuildingGrossFloorArea <https://digicities.info/proj/motel-energy/MotelA/grossFloorArea> ;
    dici_onto:hasBuildingEVCount         <https://digicities.info/proj/motel-energy/MotelA/evCount> ;
    dici_onto:hasAttribute               <https://digicities.info/proj/motel-energy/MotelA/annualElectricityConsumption> ,
                                         <https://digicities.info/proj/motel-energy/MotelA/annualHeatConsumption> ,
                                         <https://digicities.info/proj/motel-energy/MotelA/installedPVCapacity> .

<https://digicities.info/proj/motel-energy/MotelA/grossFloorArea>
    a dici_onto:GrossFloorArea ;
    rdfs:label "grossFloorArea"^^xsd:string ;
    qudt:value "1200.0"^^xsd:decimal ;
    qudt:unit unit:M2 .

<https://digicities.info/proj/motel-energy/MotelA/annualElectricityConsumption>
    a dici_onto:EnergyConsumption ;
    rdfs:label "annualElectricityConsumption"^^xsd:string ;
    qudt:value "180000.0"^^xsd:decimal ;
    qudt:unit unit:KiloW-HR .

<https://digicities.info/proj/motel-energy/MotelA/annualHeatConsumption>
    a dici_onto:EnergyConsumption ;
    rdfs:label "annualHeatConsumption"^^xsd:string ;
    qudt:value "240000.0"^^xsd:decimal ;
    qudt:unit unit:KiloW-HR .

<https://digicities.info/proj/motel-energy/MotelA/evCount>
    a dici_onto:EVCount ;
    rdfs:label "evCount"^^xsd:string ;
    qudt:value "0"^^xsd:integer .

<https://digicities.info/proj/motel-energy/MotelA/installedPVCapacity>
    a dici_onto:InstalledPVCapacity ;
    rdfs:label "installedPVCapacity"^^xsd:string ;
    qudt:value "0.0"^^xsd:decimal ;
    qudt:unit unit:KiloW .

# -----------------------------------------------------------------------------
# Motel B — medium motel, modest existing PV, one EV charger
# -----------------------------------------------------------------------------
me:MotelB
    a dici_onto:Building ;
    rdfs:label "Motel B — Lakeside"^^xsd:string ;
    dici_onto:partOf me:RoadsideMotelChain ;
    dici_onto:hasBuildingGrossFloorArea <https://digicities.info/proj/motel-energy/MotelB/grossFloorArea> ;
    dici_onto:hasBuildingEVCount         <https://digicities.info/proj/motel-energy/MotelB/evCount> ;
    dici_onto:hasAttribute               <https://digicities.info/proj/motel-energy/MotelB/annualElectricityConsumption> ,
                                         <https://digicities.info/proj/motel-energy/MotelB/annualHeatConsumption> ,
                                         <https://digicities.info/proj/motel-energy/MotelB/installedPVCapacity> .

<https://digicities.info/proj/motel-energy/MotelB/grossFloorArea>
    a dici_onto:GrossFloorArea ;
    rdfs:label "grossFloorArea"^^xsd:string ;
    qudt:value "1800.0"^^xsd:decimal ;
    qudt:unit unit:M2 .

<https://digicities.info/proj/motel-energy/MotelB/annualElectricityConsumption>
    a dici_onto:EnergyConsumption ;
    rdfs:label "annualElectricityConsumption"^^xsd:string ;
    qudt:value "260000.0"^^xsd:decimal ;
    qudt:unit unit:KiloW-HR .

<https://digicities.info/proj/motel-energy/MotelB/annualHeatConsumption>
    a dici_onto:EnergyConsumption ;
    rdfs:label "annualHeatConsumption"^^xsd:string ;
    qudt:value "320000.0"^^xsd:decimal ;
    qudt:unit unit:KiloW-HR .

<https://digicities.info/proj/motel-energy/MotelB/evCount>
    a dici_onto:EVCount ;
    rdfs:label "evCount"^^xsd:string ;
    qudt:value "1"^^xsd:integer .

<https://digicities.info/proj/motel-energy/MotelB/installedPVCapacity>
    a dici_onto:InstalledPVCapacity ;
    rdfs:label "installedPVCapacity"^^xsd:string ;
    qudt:value "20.0"^^xsd:decimal ;
    qudt:unit unit:KiloW .

# -----------------------------------------------------------------------------
# Motel C — largest motel, no PV, no EV chargers
# -----------------------------------------------------------------------------
me:MotelC
    a dici_onto:Building ;
    rdfs:label "Motel C — Mountain Pass"^^xsd:string ;
    dici_onto:partOf me:RoadsideMotelChain ;
    dici_onto:hasBuildingGrossFloorArea <https://digicities.info/proj/motel-energy/MotelC/grossFloorArea> ;
    dici_onto:hasBuildingEVCount         <https://digicities.info/proj/motel-energy/MotelC/evCount> ;
    dici_onto:hasAttribute               <https://digicities.info/proj/motel-energy/MotelC/annualElectricityConsumption> ,
                                         <https://digicities.info/proj/motel-energy/MotelC/annualHeatConsumption> ,
                                         <https://digicities.info/proj/motel-energy/MotelC/installedPVCapacity> .

<https://digicities.info/proj/motel-energy/MotelC/grossFloorArea>
    a dici_onto:GrossFloorArea ;
    rdfs:label "grossFloorArea"^^xsd:string ;
    qudt:value "2500.0"^^xsd:decimal ;
    qudt:unit unit:M2 .

<https://digicities.info/proj/motel-energy/MotelC/annualElectricityConsumption>
    a dici_onto:EnergyConsumption ;
    rdfs:label "annualElectricityConsumption"^^xsd:string ;
    qudt:value "390000.0"^^xsd:decimal ;
    qudt:unit unit:KiloW-HR .

<https://digicities.info/proj/motel-energy/MotelC/annualHeatConsumption>
    a dici_onto:EnergyConsumption ;
    rdfs:label "annualHeatConsumption"^^xsd:string ;
    qudt:value "480000.0"^^xsd:decimal ;
    qudt:unit unit:KiloW-HR .

<https://digicities.info/proj/motel-energy/MotelC/evCount>
    a dici_onto:EVCount ;
    rdfs:label "evCount"^^xsd:string ;
    qudt:value "0"^^xsd:integer .

<https://digicities.info/proj/motel-energy/MotelC/installedPVCapacity>
    a dici_onto:InstalledPVCapacity ;
    rdfs:label "installedPVCapacity"^^xsd:string ;
    qudt:value "0.0"^^xsd:decimal ;
    qudt:unit unit:KiloW .
