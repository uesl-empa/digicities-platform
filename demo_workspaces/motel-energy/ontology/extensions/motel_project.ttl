dici_onto:CAPEXperRatedPower a owl:Class ;
    rdfs:label "CAPEX per Rated Power" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:hasValue <http://qudt.org/vocab/unit/KiloW> ;
            owl:onProperty <http://qudt.org/schema/qudt/unit> ],
        dici_onto:EnergyConverterAttribute,
        dici_onto:UnitBasedCostAttribute ;
    dici_onto:hasDefaultUnit <http://qudt.org/vocab/unit/KiloW> .

