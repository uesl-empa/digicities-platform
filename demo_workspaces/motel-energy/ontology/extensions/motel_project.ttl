dici_onto:hasBuildingAttribute a owl:ObjectProperty ;
    rdfs:domain dici_onto:Building ;
    rdfs:range dici_onto:EVCount,
        dici_onto:ElectricityTariff,
        dici_onto:EnergyReferenceArea,
        dici_onto:GrossFloorArea,
        dici_onto:GrossInternalArea,
        dici_onto:LumpedHeatCapacity,
        dici_onto:LumpedHeatResistance,
        dici_onto:Month,
        dici_onto:PVRoofCoverageRatio,
        dici_onto:PeakSpaceHeatingPower ;
    rdfs:subPropertyOf dici_onto:hasLocationAttribute .

dici_onto:hasRegionAttribute a owl:ObjectProperty ;
    rdfs:domain dici_onto:Region ;
    rdfs:range dici_onto:EVPenetration,
        dici_onto:LargeChargerPercentage,
        dici_onto:MediumChargerPercentage,
        dici_onto:PolygonCoordinates,
        dici_onto:PolygonGeoJson,
        dici_onto:SmallChargerPercentage,
        dici_onto:SolarPotentialProfile ;
