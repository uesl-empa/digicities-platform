dici_onto:Building a owl:Class ;
    rdfs:label "Building" ;
    rdfs:subClassOf dici_onto:Location .

dici_onto:hasEnergyConverterAttribute rdfs:domain dici_onto:EnergyConverter ;
    rdfs:range dici_onto:CAPEX,
        dici_onto:CAPEXperRatedPower,
        dici_onto:CO2_CAP,
        dici_onto:Efficiency,
        dici_onto:InterestRate,
        dici_onto:Lifetime,
        dici_onto:OPEX,
        dici_onto:OPEX_CAP,
        dici_onto:OPEX_ENERGY,
        dici_onto:TRL .

dici_onto:Power a owl:Class ;
    rdfs:label "Power" ;
    rdfs:subClassOf dici_onto:DynamicAttribute,
        dici_onto:ElectricEnergyConsumerAttribute,
        dici_onto:ElectricEnergyGeneratorAttribute,
        dici_onto:EnergyConsumerAttribute,
        dici_onto:EnergyGeneratorAttribute,
        dici_onto:HydroReservoirAttribute,
        dici_onto:HydroTurbineAttribute,
        dici_onto:ThermalEnergyConsumerAttribute,
        dici_onto:ThermalEnergyGeneratorAttribute ;
    dici_onto:hasDefaultUnit <http://qudt.org/vocab/unit/W> .

dici_onto:hasEnergyStorageAttribute rdfs:domain dici_onto:EnergyStorage ;
    rdfs:range dici_onto:CAPEX,
        dici_onto:CO2_CAP,
        dici_onto:Charge_MAX,
        dici_onto:ChargingEfficiency,
        dici_onto:Discharge_MAX,
        dici_onto:DischargingEfficiency,
        dici_onto:Efficiency,
        dici_onto:InterestRate,
        dici_onto:Lifetime,
        dici_onto:OPEX,
        dici_onto:OPEX_CAP,
        dici_onto:SOC_MAX,
        dici_onto:SOC_MIN,
        dici_onto:StandbyLosses,
        dici_onto:TRL .

[] a owl:Restriction ;
    owl:hasValue <http://qudt.org/vocab/unit/KiloW-HR> ;
    owl:onProperty <http://qudt.org/schema/qudt/unit> .

[] dici_onto:denominatorUnit <http://qudt.org/vocab/unit/KiloW> ;
    dici_onto:numeratorUnit <http://qudt.org/vocab/unit/KiloGM> .

[] a owl:Restriction ;
    owl:hasValue <http://qudt.org/vocab/unit/KiloW> ;
    owl:onProperty <http://qudt.org/schema/qudt/unit> .



