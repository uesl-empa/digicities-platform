@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms:   <http://purl.org/dc/terms/> .
@prefix qudt:      <http://qudt.org/schema/qudt/> .
@prefix unit:      <http://qudt.org/vocab/unit/> .
@prefix dici_onto: <https://digicities.info/ontology#> .
@prefix alpine:    <https://digicities.info/tutorial/alpine_village/ontology#> .
@prefix av:        <https://digicities.info/tutorial/alpine_village/> .
@prefix sc:        <https://digicities.info/tutorial/alpine_village/scenarios/> .

# ==============================================================
# Scenario: Alpine Village — Building A PV doubled to 16 kW
#
# An assumption-applied variant of the baseline. The only thing
# the assumption changes is PV_A's peak-power attribute — the
# rest of the village stays the same.
#
# Pattern: a fresh attribute URI is created at
#   <av:PV_A/peakPower_doubled>
# typed against the same domain class (alpine:RatedElectricalPower)
# but holding the new value. The scenario declares an Assumption
# resource describing what changed and why, and links the new
# attribute via dici_onto:usedInScenario.
# ==============================================================

sc:doubled_pv_2026_04_29
    a dici_onto:Scenario ;
    rdfs:label "Alpine Village — PV doubled (2026-04-29)"^^xsd:string ;
    rdfs:comment "Variant of the baseline where Building A's rooftop PV is upgraded from 8 kW to 16 kW peak."^^xsd:string ;
    dcterms:created "2026-04-29"^^xsd:date ;
    dcterms:publisher "Digicities tutorial"^^xsd:string ;
    dici_onto:basedOn sc:baseline_2026_04_29 ;
    dici_onto:hasAssumption sc:assumption_pv_doubling ;
    dici_onto:modifiedComponents "1"^^xsd:integer .

sc:assumption_pv_doubling
    a dici_onto:Assumption, dici_onto:AssumptionSingle ;
    rdfs:label "Double rooftop PV at Building A"^^xsd:string ;
    rdfs:comment "Single-component assumption: replace PV_A's 8 kW peak power with 16 kW. Models a planned capacity expansion in 2027."^^xsd:string ;
    dici_onto:appliesToComponent av:PV_A ;
    dici_onto:appliesToAttribute alpine:RatedElectricalPower ;
    dici_onto:hasOriginalValue "8.0"^^xsd:decimal ;
    dici_onto:hasModifiedValue "16.0"^^xsd:decimal .

# Modified attribute — same domain class, new URI under the scenario
<https://digicities.info/tutorial/alpine_village/PV_A/peakPower_doubled>
    a alpine:RatedElectricalPower ;
    rdfs:label "Peak power (doubled)"^^xsd:string ;
    qudt:unit unit:KiloW ;
    dici_onto:hasUnitLabel "KiloW"^^xsd:string ;
    qudt:value "16.0"^^xsd:decimal ;
    dici_onto:supersedesAttribute <https://digicities.info/tutorial/alpine_village/PV_A/peakPower> ;
    dici_onto:usedInScenario sc:doubled_pv_2026_04_29 .

# Anchor every component to this scenario, same as the baseline
av:Grid       dici_onto:usedInScenario sc:doubled_pv_2026_04_29 .
av:BuildingA  dici_onto:usedInScenario sc:doubled_pv_2026_04_29 .
av:BuildingB  dici_onto:usedInScenario sc:doubled_pv_2026_04_29 .
av:BuildingC  dici_onto:usedInScenario sc:doubled_pv_2026_04_29 .
av:PV_A       dici_onto:usedInScenario sc:doubled_pv_2026_04_29 .
av:Battery_A  dici_onto:usedInScenario sc:doubled_pv_2026_04_29 .
av:HeatPump_B dici_onto:usedInScenario sc:doubled_pv_2026_04_29 .

av:Flow_Grid_to_A dici_onto:usedInScenario sc:doubled_pv_2026_04_29 .
av:Flow_Grid_to_B dici_onto:usedInScenario sc:doubled_pv_2026_04_29 .
av:Flow_Grid_to_C dici_onto:usedInScenario sc:doubled_pv_2026_04_29 .
av:Flow_PV_to_A   dici_onto:usedInScenario sc:doubled_pv_2026_04_29 .
av:Flow_HP_to_B   dici_onto:usedInScenario sc:doubled_pv_2026_04_29 .
