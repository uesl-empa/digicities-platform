# ============================================================
# Digicities Local Development Configuration
# Copy this file to .env and edit as needed:
#   cp .env.example .env
# ============================================================

# --- Environment mode ---
ENVIRONMENT=local
STREAMLIT_ENV=local

# --- Auth ---
# Set to true to skip login (recommended for local development)
AUTH_DISABLED=true

# --- Triplestore ---
# Default: Apache Jena Fuseki (Apache-2.0). To use Ontotext GraphDB Free
# instead (richer Workbench UI + inference, but proprietary EULA — see
# NOTICE), add docker-compose.graphdb.yml as an overlay (see below) and
# set TRIPLESTORE_BACKEND=graphdb.
TRIPLESTORE_BACKEND=fuseki
GRAPHDB_URL=http://fuseki:3030
GRAPHDB_REPOSITORY=workspace_demo

# To enable the GraphDB Free overlay, uncomment the COMPOSE_FILE block:
# COMPOSE_FILE=docker-compose.yml;docker-compose.graphdb.yml
# COMPOSE_PATH_SEPARATOR=;
# TRIPLESTORE_BACKEND=graphdb
# GRAPHDB_URL=http://graphdb:7200

# --- Local workspace (only used when AUTH_DISABLED=true) ---
# Must match the triplestore dataset/repository name
LOCAL_WORKSPACE=workspace_demo

# --- Storage ---
# "local" uses the local filesystem (data/ directory)
# "nextcloud" requires NEXTCLOUD_* vars below
STORAGE_BACKEND=local

# --- Ontology workspace (Ontology Manager module) ---
# Directory used by the Ontology Manager in local mode. The Docker stack sets
# this to /app/data/ontology via docker-compose.yml; for host-side Python
# sessions, point it at the same path relative to your clone.
# ONTOLOGY_DIR=./data/ontology

# --- Ontology upstream repo (used by Ontology Manager → Propose Upstream) ---
# GitHub <org>/<repo> hosting the public digicities-ontology. When set, the
# Propose Upstream form generates a one-click prefilled PR link for the
# promote-to-core flow (PR targets digicities-ontology/core/dici_onto_core.ttl).
# See digicities-ontology/docs/CORE_EVOLUTION.md for the promotion criteria.
# Leave commented out to use the manual-flow instructions only.
# DIGICITIES_ONTOLOGY_REPO=uesl-empa/digicities-ontology

# --- NextCloud (optional) ---
#
# Two ways to use NextCloud with this stack:
#
# 1. LOCAL NEXTCLOUD (bundled container)
#    To switch from local storage to NextCloud:
#      a. Uncomment the COMPOSE_FILE + COMPOSE_PATH_SEPARATOR lines below.
#      b. Set STORAGE_BACKEND=nextcloud in the Storage section above.
#      c. Run `docker compose up -d`.
#    It brings up the bundled NextCloud container on http://localhost:8080
#    (admin / admin) and points the app at it. Credential values are
#    local-stack defaults; change the NEXTCLOUD_BASIC_* vars before
#    exposing port 8080 beyond localhost. To go back to local, re-comment
#    those lines and set STORAGE_BACKEND=local.
#
# COMPOSE_PATH_SEPARATOR is ':' on macOS/Linux, ';' on Windows. Set both
# lines together so `docker compose up -d` picks up all three files.
#
# macOS / Linux:
# COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml:docker-compose.nextcloud.yml
# COMPOSE_PATH_SEPARATOR=:
#
# Windows:
# COMPOSE_FILE=docker-compose.yml;docker-compose.override.yml;docker-compose.nextcloud.yml
# COMPOSE_PATH_SEPARATOR=;
#
# NEXTCLOUD_BASIC_USERNAME=admin
# NEXTCLOUD_BASIC_PASSWORD=admin
#
# 2. REMOTE NEXTCLOUD (your own instance)
#    Don't enable the COMPOSE_FILE line above. Instead, set these
#    directly; they override the overlay's defaults:
# NEXTCLOUD_BASE_URL=https://your-nextcloud-instance.example.com/filestorage
# NEXTCLOUD_BASIC_USERNAME=your_username
# NEXTCLOUD_BASIC_PASSWORD=your_password

# --- External services (API submission) ---
# No credentials needed for the bundled services: the demo energy simulator runs
# locally (a compose service), and the flexibility optimiser is a separate app.
# A service is registered from its workspace template's `connection:` block.
# See docs/GETTING_STARTED.md.

# --- Keycloak (optional, only needed if AUTH_DISABLED=false) ---
# KEYCLOAK_BASE_URL=https://your-keycloak-instance.example.com
# KEYCLOAK_REALM=your_realm
# KEYCLOAK_CLIENT_ID=your_client_id
# KEYCLOAK_CLIENT_SECRET=your_client_secret
# KEYCLOAK_REDIRECT_URI=http://localhost:8501
